# Supabase Public Configuration (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Used for admin actions / seeds)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Next.js App URL (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES Database Encryption Secret Key (32-byte secret for symmetric AES-256 encryption)
DATABASE_ENCRYPTION_KEY=replace_with_a_secure_32_byte_secret_key_for_aes256
